# ==============================================
# Unified Brewfile - macOS Setup
# ==============================================
# Install all dependencies with: brew bundle
# Check what's missing with: brew bundle check

# ============================================
# Core CLI Tools
# ============================================

brew "coreutils"                     # GNU core utilities (macOS ones are outdated)
brew "moreutils"                     # Useful utilities like `sponge`
brew "findutils"                     # GNU `find`, `locate`, `updatedb`, `xargs`
brew "gnu-sed"                       # GNU `sed`
brew "bash"                          # Modern Bash
brew "bash-completion@2"             # Bash tab completions
brew "wget"                          # Download tool
brew "gnupg"                         # PGP signing for commits
brew "git"                           # Version control
brew "git-lfs"                       # Git Large File Storage
brew "gh"                            # GitHub CLI

# ============================================
# Modern CLI Replacements
# ============================================

brew "vim"                           # Updated Vim
brew "grep"                          # Updated grep
brew "openssh"                       # Updated SSH
brew "screen"                        # Terminal multiplexer (classic)
brew "ripgrep"                       # Fast grep alternative (rg)
brew "bat"                           # Cat with syntax highlighting
brew "eza"                           # Modern ls replacement
brew "fd"                            # Fast find alternative
brew "tldr"                          # Simplified man pages
brew "jq"                            # JSON processor
brew "yq"                            # YAML processor
brew "tree"                          # Directory tree viewer

# ============================================
# Shell Enhancements (Zsh)
# ============================================

brew "zsh-autosuggestions"           # Fish-like autosuggestions
brew "zsh-syntax-highlighting"       # Real-time syntax validation
brew "zsh-completions"               # Additional zsh completions
brew "fzf"                           # Fuzzy finder for files/history
brew "zoxide"                        # Smart cd replacement
brew "atuin"                         # Advanced shell history
brew "starship"                      # Modern cross-shell prompt
brew "thefuck"                       # Auto-correct failed commands

# ============================================
# Version Managers
# ============================================

brew "mise"                          # Universal version manager
brew "fnm"                           # Fast Node manager

# ============================================
# Workflow Management
# ============================================

tap  "knqyf263/pet"
brew "knqyf263/pet/pet"              # CLI snippet manager

# ============================================
# Compression & Archiving
# ============================================

brew "pigz"                          # Parallel gzip
brew "zopfli"                        # Better gzip compression
brew "p7zip"                         # 7-Zip
brew "xz"                            # XZ compression

# ============================================
# Networking & Security
# ============================================

brew "nmap"                          # Network scanner
brew "socat"                         # Multipurpose relay
brew "ssh-copy-id"                   # Install SSH keys on remote

# ============================================
# Other Useful Tools
# ============================================

brew "ack"                           # Source code search
brew "imagemagick"                   # Image manipulation
brew "lua"                           # Lua scripting
brew "lynx"                          # Terminal web browser
brew "pv"                            # Pipe viewer (progress)
brew "rename"                        # Perl-powered file rename
brew "rlwrap"                        # Readline wrapper
brew "vbindiff"                      # Visual binary diff
brew "gmp"                           # GNU multiple precision arithmetic

# ============================================
# Fonts (Nerd Fonts)
# ============================================

cask "font-monaspace-nerd-font"      # GitHub's modern font
cask "font-jetbrains-mono-nerd-font" # JetBrains Mono
cask "font-fira-code-nerd-font"      # Fira Code with ligatures
cask "font-caskaydia-cove-nerd-font" # Cascadia Code
cask "font-iosevka-nerd-font"        # Ultra-narrow Iosevka
